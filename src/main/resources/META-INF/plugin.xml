<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>dev.sal.hdl</id>
    <name>HDL Support</name>
    <vendor>Sal</vendor>
    <description><![CDATA[
        <p>Free Verilog, SystemVerilog and VHDL support for IntelliJ-based IDEs.</p>
        <ul>
            <li>Syntax highlighting that follows your colour scheme</li>
            <li>Line and block commenting</li>
        </ul>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- ===== Verilog / SystemVerilog ===== -->
        <!-- File type for .v, .vh, .sv and .svh -->
        <fileType name="Verilog/SystemVerilog" implementationClass="dev.sal.hdl.verilog.VerilogFileType"
                  fieldName="INSTANCE" language="HDL.Verilog" extensions="v;vh;sv;svh"/>
        <!-- Lexer plus a flat PSI tree, so commenters and annotators have something to run on -->
        <lang.parserDefinition language="HDL.Verilog"
                               implementationClass="dev.sal.hdl.verilog.VerilogParserDefinition"/>
        <!-- Token-based syntax highlighting -->
        <lang.syntaxHighlighterFactory language="HDL.Verilog"
                                       implementationClass="dev.sal.hdl.verilog.VerilogSyntaxHighlighterFactory"/>
        <!-- Settings | Editor | Color Scheme | Verilog/SystemVerilog -->
        <colorSettingsPage implementation="dev.sal.hdl.verilog.VerilogColorSettingsPage"/>
        <!-- Ctrl+/ and Ctrl+Shift+/ comment toggling -->
        <lang.commenter language="HDL.Verilog" implementationClass="dev.sal.hdl.verilog.VerilogCommenter"/>

        <!-- ===== VHDL ===== -->
        <!-- File type for .vhd and .vhdl -->
        <fileType name="VHDL" implementationClass="dev.sal.hdl.vhdl.VhdlFileType"
                  fieldName="INSTANCE" language="HDL.VHDL" extensions="vhd;vhdl"/>
    </extensions>
</idea-plugin>
