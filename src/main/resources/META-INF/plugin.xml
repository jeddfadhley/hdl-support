<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Permanent Marketplace ID. Never change it after the first upload. -->
    <id>io.github.jeddfadhley.hdl</id>
    <name>HDL Support</name>
    <vendor url="https://github.com/jeddfadhley/hdl-support">jeddfadhley</vendor>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- ===== Verilog / SystemVerilog ===== -->
        <!-- File type for .v, .vh, .sv and .svh -->
        <fileType name="Verilog/SystemVerilog" implementationClass="dev.sal.hdl.verilog.VerilogFileType"
                  fieldName="INSTANCE" language="HDL.Verilog" extensions="v;vh;sv;svh"/>
        <!-- Lexer plus a flat PSI tree, so commenters and annotators have something to run on -->
        <lang.parserDefinition language="HDL.Verilog"
                               implementationClass="dev.sal.hdl.verilog.VerilogParserDefinition"/>
        <!-- Token-based syntax highlighting -->
        <lang.syntaxHighlighterFactory language="HDL.Verilog"
                                       implementationClass="dev.sal.hdl.verilog.VerilogSyntaxHighlighterFactory"/>
        <!-- Settings | Editor | Color Scheme | Verilog/SystemVerilog -->
        <colorSettingsPage implementation="dev.sal.hdl.verilog.VerilogColorSettingsPage"/>
        <!-- Ctrl+/ and Ctrl+Shift+/ comment toggling -->
        <lang.commenter language="HDL.Verilog" implementationClass="dev.sal.hdl.verilog.VerilogCommenter"/>
        <!-- Structure tool window and File Structure popup: modules, ports, signals, processes, instances -->
        <lang.psiStructureViewFactory language="HDL.Verilog"
                                      implementationClass="dev.sal.hdl.verilog.VerilogStructureViewFactory"/>
        <!-- Folding for modules, begin/end and other keyword blocks, port lists and block comments -->
        <lang.foldingBuilder language="HDL.Verilog" implementationClass="dev.sal.hdl.verilog.VerilogFoldingBuilder"/>
        <!-- Highlights and jumps between matching (), [] and {} -->
        <lang.braceMatcher language="HDL.Verilog" implementationClass="dev.sal.hdl.verilog.VerilogBraceMatcher"/>
        <!-- Highlights and jumps between matching keywords: begin/end, module/endmodule, case/endcase, ... -->
        <codeBlockSupportHandler language="HDL.Verilog"
                                 implementationClass="dev.sal.hdl.editor.HdlCodeBlockSupportHandler"/>
        <!-- Completion: keywords, declared names, modules, ports in instances, $system tasks, `directives -->
        <completion.contributor language="HDL.Verilog"
                                implementationClass="dev.sal.hdl.completion.VerilogCompletionContributor"/>
        <!-- Typing " inserts a pair of quotes; typing " before a closing quote steps over it -->
        <lang.quoteHandler language="HDL.Verilog" implementationClass="dev.sal.hdl.editor.VerilogQuoteHandler"/>
        <!-- Live templates mod, aff, affr, acomb, cas, tb, ... from liveTemplates/Verilog.xml -->
        <defaultLiveTemplates file="/liveTemplates/Verilog.xml"/>
        <!-- Lets the Verilog templates expand in Verilog code, but not in comments or strings -->
        <liveTemplateContext contextId="VERILOG" implementation="dev.sal.hdl.editor.VerilogTemplateContext"/>
        <!-- Verilator lint squiggles -->
        <externalAnnotator language="HDL.Verilog" implementationClass="dev.sal.hdl.lint.VerilatorAnnotator"/>

        <!-- ===== VHDL ===== -->
        <!-- File type for .vhd and .vhdl -->
        <fileType name="VHDL" implementationClass="dev.sal.hdl.vhdl.VhdlFileType"
                  fieldName="INSTANCE" language="HDL.VHDL" extensions="vhd;vhdl"/>
        <!-- Lexer plus a flat PSI tree, so commenters and annotators have something to run on -->
        <lang.parserDefinition language="HDL.VHDL" implementationClass="dev.sal.hdl.vhdl.VhdlParserDefinition"/>
        <!-- Token-based syntax highlighting -->
        <lang.syntaxHighlighterFactory language="HDL.VHDL"
                                       implementationClass="dev.sal.hdl.vhdl.VhdlSyntaxHighlighterFactory"/>
        <!-- Settings | Editor | Color Scheme | VHDL -->
        <colorSettingsPage implementation="dev.sal.hdl.vhdl.VhdlColorSettingsPage"/>
        <!-- Ctrl+/ and Ctrl+Shift+/ comment toggling -->
        <lang.commenter language="HDL.VHDL" implementationClass="dev.sal.hdl.vhdl.VhdlCommenter"/>
        <!-- Structure tool window and File Structure popup: entities, architectures, ports, signals, processes -->
        <lang.psiStructureViewFactory language="HDL.VHDL"
                                      implementationClass="dev.sal.hdl.vhdl.VhdlStructureViewFactory"/>
        <!-- Folding for design units, processes, generate and other keyword blocks, port clauses and block comments -->
        <lang.foldingBuilder language="HDL.VHDL" implementationClass="dev.sal.hdl.vhdl.VhdlFoldingBuilder"/>
        <!-- Highlights and jumps between matching () and [] -->
        <lang.braceMatcher language="HDL.VHDL" implementationClass="dev.sal.hdl.vhdl.VhdlBraceMatcher"/>
        <!-- Highlights and jumps between matching keywords: process/end process, if/elsif/else/end if, ... -->
        <codeBlockSupportHandler language="HDL.VHDL"
                                 implementationClass="dev.sal.hdl.editor.HdlCodeBlockSupportHandler"/>
        <!-- Completion: keywords, standard types, declared names, entities and packages, ports, 'attributes -->
        <completion.contributor language="HDL.VHDL"
                                implementationClass="dev.sal.hdl.completion.VhdlCompletionContributor"/>
        <!-- Typing " inserts a pair of quotes, also after a bit-string base (x"); ' isn't paired -->
        <lang.quoteHandler language="HDL.VHDL" implementationClass="dev.sal.hdl.editor.VhdlQuoteHandler"/>
        <!-- Live templates lib, ent, arch, design, proc, procr, cas, tb, ... from liveTemplates/VHDL.xml -->
        <defaultLiveTemplates file="/liveTemplates/VHDL.xml"/>
        <!-- Lets the VHDL templates expand in VHDL code, but not in comments or strings -->
        <liveTemplateContext contextId="VHDL" implementation="dev.sal.hdl.editor.VhdlTemplateContext"/>
        <!-- GHDL syntax-check squiggles -->
        <externalAnnotator language="HDL.VHDL" implementationClass="dev.sal.hdl.lint.GhdlAnnotator"/>

        <!-- ===== Shared ===== -->
        <!-- Index of module, entity and package names, used by go-to-definition across files -->
        <fileBasedIndex implementation="dev.sal.hdl.navigation.HdlUnitIndex"/>
        <!-- Enter after begin, module m(...);, if ... then and other block openers adds the matching end -->
        <enterHandlerDelegate implementation="dev.sal.hdl.editor.HdlEnterHandler"/>
        <!-- Settings | Tools | HDL Support: tool paths, enable toggles, extra arguments -->
        <applicationConfigurable parentId="tools" instance="dev.sal.hdl.settings.HdlSettingsConfigurable"
                                 id="dev.sal.hdl.settings" displayName="HDL Support"/>
        <!-- Balloon shown once per session when a lint tool can't be found -->
        <notificationGroup id="HDL Support" displayType="BALLOON"/>
        <!-- Output of Show Synthesis Stats, one tab per run; hidden until first used -->
        <toolWindow id="Yosys" anchor="bottom" icon="AllIcons.Toolwindows.ToolWindowBuild" canCloseContents="true"
                    doNotActivateOnStart="true" factoryClass="dev.sal.hdl.yosys.YosysToolWindowFactory"/>
    </extensions>

    <actions>
        <!-- Synthesises the module at the caret with Yosys and shows its cell counts -->
        <action id="dev.sal.hdl.ShowSynthesisStats" class="dev.sal.hdl.yosys.ShowSynthesisStatsAction"
                text="Show Synthesis Stats" icon="AllIcons.Actions.Execute"
                description="Synthesise the Verilog module at the caret with Yosys and show its statistics">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
