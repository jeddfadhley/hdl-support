<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Permanent Marketplace ID. Never change it after the first upload. -->
    <id>io.github.jeddfadhley.hdl</id>
    <name>HDL Support</name>
    <vendor url="https://github.com/jeddfadhley/hdl-support">jeddfadhley</vendor>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- ===== Verilog / SystemVerilog ===== -->
        <!-- File type for .v, .vh, .sv and .svh -->
        <fileType name="Verilog/SystemVerilog" implementationClass="dev.sal.hdl.verilog.VerilogFileType"
                  fieldName="INSTANCE" language="HDL.Verilog" extensions="v;vh;sv;svh"/>
        <!-- Lexer plus a flat PSI tree, so commenters and annotators have something to run on -->
        <lang.parserDefinition language="HDL.Verilog"
                               implementationClass="dev.sal.hdl.verilog.VerilogParserDefinition"/>
        <!-- Token-based syntax highlighting -->
        <lang.syntaxHighlighterFactory language="HDL.Verilog"
                                       implementationClass="dev.sal.hdl.verilog.VerilogSyntaxHighlighterFactory"/>
        <!-- Settings | Editor | Color Scheme | Verilog/SystemVerilog -->
        <colorSettingsPage implementation="dev.sal.hdl.verilog.VerilogColorSettingsPage"/>
        <!-- Ctrl+/ and Ctrl+Shift+/ comment toggling -->
        <lang.commenter language="HDL.Verilog" implementationClass="dev.sal.hdl.verilog.VerilogCommenter"/>
        <!-- Verilator lint squiggles -->
        <externalAnnotator language="HDL.Verilog" implementationClass="dev.sal.hdl.lint.VerilatorAnnotator"/>

        <!-- ===== VHDL ===== -->
        <!-- File type for .vhd and .vhdl -->
        <fileType name="VHDL" implementationClass="dev.sal.hdl.vhdl.VhdlFileType"
                  fieldName="INSTANCE" language="HDL.VHDL" extensions="vhd;vhdl"/>
        <!-- Lexer plus a flat PSI tree, so commenters and annotators have something to run on -->
        <lang.parserDefinition language="HDL.VHDL" implementationClass="dev.sal.hdl.vhdl.VhdlParserDefinition"/>
        <!-- Token-based syntax highlighting -->
        <lang.syntaxHighlighterFactory language="HDL.VHDL"
                                       implementationClass="dev.sal.hdl.vhdl.VhdlSyntaxHighlighterFactory"/>
        <!-- Settings | Editor | Color Scheme | VHDL -->
        <colorSettingsPage implementation="dev.sal.hdl.vhdl.VhdlColorSettingsPage"/>
        <!-- Ctrl+/ and Ctrl+Shift+/ comment toggling -->
        <lang.commenter language="HDL.VHDL" implementationClass="dev.sal.hdl.vhdl.VhdlCommenter"/>
        <!-- GHDL syntax-check squiggles -->
        <externalAnnotator language="HDL.VHDL" implementationClass="dev.sal.hdl.lint.GhdlAnnotator"/>

        <!-- ===== Shared ===== -->
        <!-- Settings | Tools | HDL Support: tool paths, enable toggles, extra arguments -->
        <applicationConfigurable parentId="tools" instance="dev.sal.hdl.settings.HdlSettingsConfigurable"
                                 id="dev.sal.hdl.settings" displayName="HDL Support"/>
        <!-- Balloon shown once per session when a lint tool can't be found -->
        <notificationGroup id="HDL Support" displayType="BALLOON"/>
    </extensions>
</idea-plugin>
